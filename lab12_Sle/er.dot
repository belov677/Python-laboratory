digraph ER {
  rankdir=LR; node [shape=plaintext, fontname="DejaVu Sans", fontsize=10]; edge [fontname="DejaVu Sans", fontsize=9];
  clients [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dde7f7"><b>clients</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">name NOT NULL</td></tr><tr><td align="left">email UNIQUE</td></tr><tr><td align="left">phone</td></tr><tr><td align="left">city NOT NULL</td></tr><tr><td align="left">created_at</td></tr></table>>];
  shipments [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dde7f7"><b>shipments</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">tracking_number UNIQUE</td></tr><tr><td align="left">FK client_id</td></tr><tr><td align="left">origin, destination</td></tr><tr><td align="left">distance_km CHECK &gt; 0</td></tr><tr><td align="left">status ENUM</td></tr><tr><td align="left">cost CHECK ≥ 0</td></tr><tr><td align="left">created_at, delivered_at</td></tr></table>>];
  cargos [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dde7f7"><b>cargos</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">description</td></tr><tr><td align="left">cargo_type</td></tr><tr><td align="left">weight_kg CHECK &gt; 0</td></tr><tr><td align="left">declared_value CHECK ≥ 0</td></tr></table>>];
  shipment_cargo [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#f7ecd5"><b>shipment_cargo</b></td></tr><tr><td align="left">PK,FK shipment_id</td></tr><tr><td align="left">PK,FK cargo_id</td></tr></table>>];
  events [label=<<table border="0" cellborder="1" cellspacing="0"><tr><td bgcolor="#dde7f7"><b>tracking_events</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK shipment_id</td></tr><tr><td align="left">status ENUM</td></tr><tr><td align="left">location</td></tr><tr><td align="left">comment</td></tr><tr><td align="left">created_at</td></tr></table>>];
  clients -> shipments [label="1 : N"]; shipments -> shipment_cargo [label="1 : N"]; cargos -> shipment_cargo [label="1 : N"]; shipments -> events [label="1 : N"];
}
